---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero">
        <h1>Andrew Thiesen</h1>
        <a
          target="_blank"
          href="/rss.xml"
          class="rss-link"
          aria-label="rss feed"
          title="RSS Feed"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="rss-icon"
            ><path
              d="M19 20.001C19 11.729 12.271 5 4 5v2c7.168 0 13 5.832 13 13.001h2z"
            ></path><path
              d="M12 20.001h2C14 14.486 9.514 10 4 10v2c4.411 0 8 3.589 8 8.001z"
            ></path><circle cx="6" cy="18" r="2"></circle>
          </svg>
          <span class="sr-only">RSS Feed</span>
        </a>

        <p class="text-lg mt-4 text-skin-base/90">
          Systems Architect & Machine Learning Engineer based in Naples, FL. 
        </p>
        <p class="mt-2 text-skin-base/80">
          I bridge the gap between complex hardware systems, robust cybersecurity baselines, and modern automation. Currently, I focus on engineering resilient server infrastructure, automating enterprise lifecycles with PowerShell, and exploring edge-compute architectures through my initiative, <strong>Black Anchor Works</strong>.
        </p>

        <div class="mt-6 flex flex-col sm:flex-row gap-4">
           <a href="mailto:aj@ajthiesen.com" class="inline-block px-5 py-2 border border-skin-accent text-skin-accent hover:bg-skin-accent hover:text-skin-inverted transition-colors rounded-md text-center font-semibold">
            Contact Me
          </a>
          <a href="/about" class="inline-block px-5 py-2 bg-skin-fill border border-skin-line hover:border-skin-accent transition-colors rounded-md text-center">
            View Resume & Bio
          </a>
        </div>

        {
          // SocialLinks component is already imported at the top of the file
          socialCount > 0 && (
            <div class="social-wrapper mt-8">
              <div class="social-links">Social Links:</div>
              <Socials />
            </div>
          )
        }
      </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        All Posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
